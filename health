#!/usr/bin/env bash

# Parse flags
SHOW_IP=false
EXPORT_FILE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --ip)
            SHOW_IP=true
            shift
            ;;
        -e|--export)
            if [[ -n "$2" && "$2" != -* ]]; then
                EXPORT_FILE="$2"
                shift 2
            else
                EXPORT_FILE="health-report-$(date +%Y%m%d-%H%M%S).txt"
                shift
            fi
            ;;
        -h|--help)
            echo "Usage: health [OPTIONS]"
            echo "Options:"
            echo "  --ip                Show local and public IP addresses (hidden by default)"
            echo "  -e, --export [FILE] Export report to a formatted text file (defaults to timestamped filename)"
            echo "  -h, --help          Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1 (use --help for usage)"
            exit 1
            ;;
    esac
done

# Colors for readability
BOLD="\e[1m"
CYAN="\e[36m"
GREEN="\e[32m"
YELLOW="\e[33m"
RED="\e[31m"
RESET="\e[0m"

header() {
    echo -e "\n${BOLD}${CYAN}=== $1 ===${RESET}"
}

run_checks() {
    echo -e "${BOLD}CachyOS System Health Report${RESET} — Generated on $(date '+%Y-%m-%d %H:%M:%S')"

    # 1. System & Kernel Info
    header "SYSTEM & KERNEL"
    echo -e "${BOLD}OS:${RESET}       $(grep PRETTY_NAME /etc/os-release | cut -d'"' -f2)"
    echo -e "${BOLD}Kernel:${RESET}   $(uname -r)"
    echo -e "${BOLD}Uptime:${RESET}   $(uptime -p | sed 's/up //')"

    # 2. CPU, Load & Temperatures
    header "CPU, LOAD & TEMPERATURES"
    CPU_MODEL=$(lscpu | grep "Model name:" | sed 's/Model name:[ \t]*//')
    LOAD=$(uptime | awk -F'load average:' '{ print $2 }' | xargs)
    CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print 100 - $8"%"}')
    echo -e "${BOLD}Model:${RESET}    $CPU_MODEL"
    echo -e "${BOLD}Usage:${RESET}    $CPU_USAGE"
    echo -e "${BOLD}Load Avg:${RESET} $LOAD (1m, 5m, 15m)"

    if command -v sensors &> /dev/null; then
        sensors | grep -E "Package id|Tctl|Tdie|edge|junction|Composite|temp1" | sed 's/^[ \t]*//' | while IFS= read -r line; do
            echo -e "${BOLD}Temp:${RESET}     $line"
        done
    else
        echo -e "${YELLOW}lm_sensors not installed. Reading raw thermal zones:${RESET}"
        for zone in /sys/class/thermal/thermal_zone*; do
            if [ -f "$zone/temp" ]; then
                type=$(cat "$zone/type")
                temp=$(awk '{printf "%.1f°C", $1/1000}' "$zone/temp")
                echo -e "${BOLD}Temp:${RESET}     $type: $temp"
            fi
        done
    fi

    # 3. GPU Stats (Handles single and dual-GPU laptops cleanly)
    header "GPU"
    if command -v nvidia-smi &> /dev/null && nvidia-smi -L &> /dev/null; then
        nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader,nounits | \
        awk -F', ' '{printf "NVIDIA:   %s (Usage: %s%% | VRAM: %s / %s MiB | Temp: %s°C)\n", $1, $2, $3, $4, $5}'
    fi

    IDX=1
    while IFS= read -r gpu_line; do
        CLEAN_NAME=$(echo "$gpu_line" | cut -d':' -f3 | xargs)
        echo -e "${BOLD}GPU $IDX:${RESET}    $CLEAN_NAME"
        ((IDX++))
    done < <(lspci | grep -iE 'vga|3d|display')

    # 4. Memory & ZRAM / Swap
    header "MEMORY & ZRAM"
    free -h | awk '
    NR==1 {printf "%-10s %-10s %-10s %-10s\n", "", $1, $2, $6}
    NR==2 {printf "%-10s %-10s %-10s %-10s\n", "RAM:", $2, $3, $7}
    NR==3 {printf "%-10s %-10s %-10s %-10s\n", "Swap:", $2, $3, "N/A"}
    '

    if command -v zramctl &> /dev/null && [ -n "$(zramctl)" ]; then
        echo -e "\n${BOLD}ZRAM Details (CachyOS Default):${RESET}"
        zramctl
    fi

    # 5. Storage & S.M.A.R.T. Health
    header "STORAGE & S.M.A.R.T."
    df -h -x tmpfs -x devtmpfs -x squashfs -x efivarfs | grep -v "/run/user/" | awk -v show_ip="$SHOW_IP" '
    NR==1 {printf "%-28s %-8s %-8s %-8s %-6s %s\n", $1, $2, $3, $4, $5, $6}
    NR>1  {
        fs=$1
        if (show_ip != "true" && fs ~ /^\/\/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/) {
            sub(/^\/\/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/, "//[IP Hidden]", fs)
        }
        printf "%-28s %-8s %-8s %-8s %-6s %s\n", fs, $2, $3, $4, $5, $6
    }'

    echo -e "\n${BOLD}Drive Health (S.M.A.R.T.):${RESET}"
    if command -v smartctl &> /dev/null; then
        for dev in $(lsblk -dn -o NAME,TYPE | awk '$2=="disk" && $1 !~ /^zram/ {print "/dev/"$1}'); do
            # Skip S.M.A.R.T. queries on SD/MMC cards
            if [[ "$dev" == /dev/mmcblk* ]]; then
                echo -e "  ${BOLD}$dev:${RESET} N/A (SD/MMC storage - S.M.A.R.T. unsupported)"
                continue
            fi

            SMART_OUT=$(smartctl -H -A "$dev" 2>/dev/null)
            if ! echo "$SMART_OUT" | grep -qE "PASSED|OK|FAILED"; then
                SMART_OUT=$(sudo -n smartctl -H -A "$dev" 2>/dev/null)
            fi

            if echo "$SMART_OUT" | grep -qE "PASSED|OK|FAILED"; then
                STATUS=$(echo "$SMART_OUT" | grep -E "SMART overall-health|SMART Health Status" | awk -F': ' '{print $2}' | xargs)
                TEMP=$(echo "$SMART_OUT" | awk '/Temperature:/ {print $2"°C"; exit} /Temperature_Celsius/ {print $10"°C"; exit}')
                WEAR=$(echo "$SMART_OUT" | awk '/Percentage Used:/ {print 100-$3"% life left"; exit} /Wear_Leveling_Count|Media_Wearout_Indicator/ {print $4"% life left"; exit}')
                HOURS=$(echo "$SMART_OUT" | awk '/Power On Hours:/ {gsub(/,/, "", $4); print $4"h"; exit} /Power_On_Hours/ {print $10"h"; exit}')

                if [[ "$STATUS" == "PASSED" || "$STATUS" == "OK" ]]; then
                    STATUS_COLOR="${GREEN}${STATUS}${RESET}"
                else
                    STATUS_COLOR="${RED}${STATUS}${RESET}"
                fi

                DETAILS=""
                [ -n "$TEMP" ] && DETAILS+="Temp: $TEMP"
                [ -n "$WEAR" ] && DETAILS+="${DETAILS:+ | }Health: $WEAR"
                [ -n "$HOURS" ] && DETAILS+="${DETAILS:+ | }Power-On: $HOURS"

                echo -e "  ${BOLD}$dev:${RESET} $STATUS_COLOR ${DETAILS:+($DETAILS)}"
            else
                echo -e "  ${BOLD}$dev:${RESET} ${YELLOW}S.M.A.R.T. unavailable or unsupported${RESET}"
            fi
        done
    else
        echo -e "  ${YELLOW}smartmontools not installed (install with: sudo pacman -S smartmontools)${RESET}"
    fi

    # 6. Network & Internet
    header "NETWORK & INTERNET"
    ACTIVE_IFACE=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}')
    if [ -n "$ACTIVE_IFACE" ]; then
        if [ "$SHOW_IP" = true ]; then
            LOCAL_IP=$(ip -4 addr show "$ACTIVE_IFACE" | awk '/inet / {print $2}' | cut -d/ -f1)
            PUBLIC_IP=$(curl -s --max-time 2 https://ifconfig.me || echo "Unavailable")
            echo -e "${BOLD}Interface:${RESET} $ACTIVE_IFACE"
            echo -e "${BOLD}Local IP:${RESET}  ${LOCAL_IP:-Unavailable}"
            echo -e "${BOLD}Public IP:${RESET} $PUBLIC_IP"
        else
            echo -e "${BOLD}Interface:${RESET} $ACTIVE_IFACE (IP Hidden - use --ip to view)"
        fi
        
        # Ping check for connectivity & latency
        PING_MS=$(ping -c 1 -W 2 1.1.1.1 2>/dev/null | awk -F'time=' '/time=/ {print $2}')
        if [ -n "$PING_MS" ]; then
            echo -e "${BOLD}Internet:${RESET}  ${GREEN}Connected${RESET} (Latency: $PING_MS)"
        else
            echo -e "${BOLD}Internet:${RESET}  ${RED}Unreachable (No ping response)${RESET}"
        fi

        # DNS resolution check
        if getent hosts archlinux.org &> /dev/null; then
            echo -e "${BOLD}DNS:${RESET}       ${GREEN}Working${RESET}"
        else
            echo -e "${BOLD}DNS:${RESET}       ${RED}Failed${RESET}"
        fi
    else
        echo -e "${BOLD}Interface:${RESET} ${RED}Disconnected (No active route)${RESET}"
    fi

    # 7. CachyOS / Arch Maintenance Health
    header "SYSTEMD & PACKAGE HEALTH"
    FAILED_UNITS=$(systemctl --failed --no-legend | wc -l)
    if [ "$FAILED_UNITS" -eq 0 ]; then
        echo -e "${BOLD}Systemd:${RESET}  ${GREEN}All services running cleanly (0 failed)${RESET}"
    else
        echo -e "${BOLD}Systemd:${RESET}  ${RED}$FAILED_UNITS failed service(s) detected:${RESET}"
        systemctl --failed --no-legend
    fi

    if command -v pacman &> /dev/null; then
        ORPHANS=$(pacman -Qtdq | wc -l)
        CACHE_SIZE=$(du -sh /var/cache/pacman/pkg/ 2>/dev/null | cut -f1)
        echo -e "${BOLD}Orphans:${RESET}  $ORPHANS unused package(s)"
        echo -e "${BOLD}Cache:${RESET}    ${CACHE_SIZE:-0B} in /var/cache/pacman/pkg/"
    fi
    echo ""
}

# Execute and optionally export
if [ -n "$EXPORT_FILE" ]; then
    OUTPUT=$(run_checks)
    echo -e "$OUTPUT"
    echo -e "$OUTPUT" | sed -r 's/\x1B\[([0-9]{1,3}(;[0-9]{1,2};?)?)?[mGK]//g' > "$EXPORT_FILE"
    echo -e "${GREEN}✔ Report exported to:${RESET} $EXPORT_FILE"
else
    run_checks
fi
